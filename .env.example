# Copy to .env.local for local development. In production set these in
# Vercel → Project → Settings → Environment Variables. Never commit real values.

# --- Integrations (required for Gmail / Google Calendar) ---
# Any long random string (at least 32 characters), e.g. `openssl rand -base64 48`.
# Encrypts stored Google tokens. Changing it disconnects every Google account.
INTEGRATIONS_ENCRYPTION_KEY=

# Google Cloud → APIs & Services → Credentials → OAuth client (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional. Defaults to <site origin>/factory/connections/google
GOOGLE_REDIRECT_URI=

# --- Factory platform accounts (admin only, used to build and ship customer projects) ---
# GitHub fine-grained personal access token (repo contents, administration, metadata)
GITHUB_TOKEN=
# Optional: GitHub user or org that owns new customer repos (defaults to the token's user)
GITHUB_OWNER=
# Optional: "owner/repo" of a GitHub template repo new projects start from (otherwise a README-only repo)
GITHUB_TEMPLATE_REPO=
# Vercel → Account Settings → Tokens
VERCEL_TOKEN=
# Optional: Vercel team ID if projects live under a team
VERCEL_TEAM_ID=
# Supabase → Account → Access Tokens (Management API)
SUPABASE_ACCESS_TOKEN=
# Optional: Supabase organization slug for new customer databases (defaults to the first org)
SUPABASE_ORG_SLUG=
