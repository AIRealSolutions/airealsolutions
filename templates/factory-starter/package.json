{
  "name": "factory-starter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AI Real Solutions Factory starter: Next.js + Supabase (auth, RLS) + Resend, rendered from site.json.",
  "engines": { "node": ">=22.18" },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --test \"tests/unit/*.test.mjs\"",
    "test:smoke": "playwright test --trace off",
    "test:rls": "bash supabase/tests/run.sh",
    "check": "npm run typecheck && npm run test:unit && npm run build && npm run test:smoke"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.2",
    "next": "16.4.5",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "^5.9"
  }
}
