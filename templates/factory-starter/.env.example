# Supabase (Project Settings -> API). The publishable key is safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Site address, used in sign-in links and emails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Email (Resend). Server only. Without these, submissions still save; no email is sent.
RESEND_API_KEY=
EMAIL_FROM="Your Business <hello@yourdomain.com>"
OWNER_EMAIL=

# true = show the demo rows from site.json on dashboards (prototypes only, never in production).
NEXT_PUBLIC_DEMO_MODE=false
